<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <connectionStrings>
    <!-- Configuração local do XAMPP. Ajuste usuário, senha e porta se necessário. -->
    <add name="Tecnologia" connectionString="Server=127.0.0.1;Port=3306;Database=tecnologia;Uid=root;Pwd=;SslMode=Preferred;CharSet=utf8mb4;" providerName="MySqlConnector" />
  </connectionStrings>
  <appSettings>
    <!-- SMTP com STARTTLS. Nunca publique a senha do e-mail neste arquivo. -->
    <add key="SmtpHost" value="" />
    <add key="SmtpPort" value="587" />
    <add key="SmtpFrom" value="" />
    <add key="SmtpUser" value="" />
    <!-- Senha: variável de ambiente TECNOLOGIA_SMTPPASSWORD. -->
  </appSettings>
</configuration>
